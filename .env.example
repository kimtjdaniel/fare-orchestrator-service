# Copy to .env and fill in. Everything defaults to mock mode, so the app runs with no keys at all.

# ---- Mock switches ----
# LLM: false = live Gemini. true = canned Maya/beach demo answers.
MOCK_LLM=false
MOCK_TRAVEL=false
MOCK_BROWSER=true
MOCK_BOOKING_DELAY=3

# ---- Gemini (required when MOCK_LLM=false) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Empty = always hit the API. .llm_cache replays identical requests.
LLM_CACHE_DIR=

# ---- Database ----
# Empty = in-memory (forgotten on restart). Local Docker: docker compose up -d
# Atlas: mongodb+srv://USER:PASS@cluster...  (password URL-encoded)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=fare

# ---- Messaging ----
# console | robot | telegram
# Use robot to talk to whatsapp-service on ROBOT_URL.
MESSAGING_BACKEND=console
ROBOT_URL=http://localhost:3000
# Same value as whatsapp-service SERVICE_TOKEN (Bearer on POST /send). Empty = robot is unprotected.
SERVICE_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
BOT_NAME=Fare
TIMEZONE=America/Vancouver

# ---- Booking ----
SKYVERN_API_KEY=
HOTEL_CHECKOUT_URL=https://example-fake-hotel.vercel.app
SKYVERN_MAX_STEPS=25

# ---- Dashboard ----
# Leave empty unless you actually have a public trip page to share.
DASHBOARD_URL=

PORT=8000

# ---- Travel search services ----
# MOCK_TRAVEL=false invokes these real Lambda services.
# Public backend URL reachable from AWS; enables per-request recording/results callbacks.
# Example: https://your-orchestrator.example.com (no trailing path).
ORCHESTRATOR_PUBLIC_URL=
FLIGHT_SERVICE_URL=https://oi4ykhnpbgrgeedjtljdjdg6qe0luuug.lambda-url.us-west-2.on.aws/
HOTEL_SERVICE_URL=https://qhz6talpesw4nfnbipkxnxxsq40ivfah.lambda-url.us-west-2.on.aws/
# Set both WebSocket URLs to forward browser frames and live service progress.
# Leave empty to use the HTTP Lambda URLs above.
FLIGHT_SERVICE_WS_URL=
HOTEL_SERVICE_WS_URL=
# The local Python bridges allow this Origin for their WebSocket handshake.
SEARCH_FRONTEND_ORIGIN=http://localhost:3000
