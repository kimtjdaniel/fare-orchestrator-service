# Copy to .env and fill in. Everything defaults to mock mode, so the app runs with no keys at all.
# Keep comments on their own lines: "KEY=   # note" makes the note the value.

# ---- Mock switches (flip one at a time as real pieces land) ----
# true = canned Claude responses, zero API spend
MOCK_LLM=true
# true = fake flights/hotels (P3 swaps in Duffel)
MOCK_TRAVEL=true
# true = fake hotel booking (P4 swaps in Skyvern)
MOCK_BROWSER=true
# seconds the fake hotel booking "takes" (tests use 0)
MOCK_BOOKING_DELAY=3

# ---- Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# identical Claude requests are served from disk; leave empty to disable
LLM_CACHE_DIR=.llm_cache

# ---- Database ----
# Empty = in-memory store (lost on restart; fine for solo dev).
# Supabase: Connect button -> Session pooler URI. Local: postgresql://yate:yate@localhost:5432/yate
DATABASE_URL=

# ---- Messaging (P2 owns the channel; brain only needs to know where to send) ----
# console | robot | telegram
MESSAGING_BACKEND=console
# whatsapp-web.js robot's /send mailbox (must be reachable FROM the brain, see SETUP.md)
ROBOT_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=
# without the @, e.g. fare_travel_bot
TELEGRAM_BOT_USERNAME=
# any random string; pass the same value as secret_token in setWebhook
TELEGRAM_WEBHOOK_SECRET=
BOT_NAME=Fare
# resolves "this weekend" etc.; servers run in UTC
TIMEZONE=America/Vancouver

# ---- Booking ----
SKYVERN_API_KEY=
# P4's deployed fake checkout (must be public: Skyvern Cloud can't reach localhost)
HOTEL_CHECKOUT_URL=https://example-fake-hotel.vercel.app
SKYVERN_MAX_STEPS=25

# ---- Dashboard ----
# P4's Next.js app; chat links are {DASHBOARD_URL}/trip/{id}
DASHBOARD_URL=http://localhost:3001
